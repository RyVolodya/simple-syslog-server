POSTGRES_DB=rsyslog
POSTGRES_USER=syslog
POSTGRES_PASSWORD=change-this-password
WEB_PORT=8080
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=514
CLIENT_DOMAIN=http://localhost:8080
CORS_DOMAINS=http://localhost:8080

# Set to true only when the web interface is served over HTTPS
COOKIE_SECURE=false

# Time zone is inherited automatically from the Linux host.
